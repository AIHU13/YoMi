# ============ 基础运行 ============
APP_NAME=YoMi助手
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
DATA_DIR=data
SCHEDULER_ENABLED=true

# ============ 飞书自建应用 ============
# 飞书开放平台 -> 开发者后台 -> 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 官方 SDK 长连接订阅（推荐）：无需公网域名/IP，直接接收事件与卡片回调
FEISHU_LONG_CONN_ENABLED=true
# 仅在使用 HTTP Webhook 方式接收回调时才需要（长连接模式可留空）
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_API_BASE=https://open.feishu.cn/open-apis
# 单用户自用：接收卡片消息的用户 open_id
FEISHU_USER_OPEN_ID=
# true 时不发真实请求，用于本地联调流程
FEISHU_DRY_RUN=false

# ============ 飞书多维表格 ============
# 5 张表固定在一个多维表格 base 中，各表在 base 内分别建表
BITABLE_APP_TOKEN=
BITABLE_GOALS_TABLE_ID=
BITABLE_STANDARDS_TABLE_ID=
BITABLE_DAILY_TABLE_ID=
BITABLE_WEEKLY_TABLE_ID=
BITABLE_PORTRAIT_TABLE_ID=

# ============ LLM（OpenAI 兼容接口，如 DeepSeek） ============
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# 推理类模型（如 glm 系列）会先消耗思考 token，建议不低于 4000
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2

# ============ 定时触发（按本地时区） ============
DAILY_PUSH_TIME=22:00
WEEKLY_PUSH_WEEKDAY=5          # 0=周一 ... 5=周六 ... 6=周日
WEEKLY_PUSH_TIME=22:00
MONTHLY_PUSH_DAY=1
MONTHLY_PUSH_TIME=22:00
DAILY_CONFIRM_DEADLINE=23:59

# ============ HTTP 重试 ============
REQUEST_RETRY_TIMES=3
REQUEST_TIMEOUT_SECONDS=20
